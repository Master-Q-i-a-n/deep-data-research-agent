# Docker Compose 镜像配置（ECS 与 ACR 同 VPC 时使用专有网络地址）
ACR_REGISTRY=crpi-p616bctlmo5gl0r0-vpc.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=deep-agents
ACR_REPOSITORY=agent-api
# 必须替换为 GitHub Actions 成功构建时对应的完整 40 位 commit SHA。
IMAGE_TAG=replace-with-full-40-character-git-sha
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
WEB_HTTPS_PORT=443
TLS_CERTIFICATE_FILE_HOST=./.secrets/tls/server.crt
TLS_PRIVATE_KEY_FILE_HOST=./.secrets/tls/server.key
REDIS_PASSWORD_FILE_HOST=./.secrets/redis_password
MODEL_PROVIDER_ENCRYPTION_KEY_FILE_HOST=./.secrets/model_provider_key

# 单机 PostgreSQL。三个密码请分别运行 `openssl rand -hex 24` 生成。
# Compose 会据此构造 DATABASE_URI 和 POSTGRES_URI，不需要数据库内外网地址。
POSTGRES_ADMIN_PASSWORD=replace-with-random-hex
POSTGRES_MIGRATOR_PASSWORD=replace-with-random-hex
POSTGRES_APP_PASSWORD=replace-with-random-hex

# 单机 MongoDB。练习部署由应用直接使用 root 账号。
MONGO_ROOT_PASSWORD=replace-with-random-hex

# OpenSandbox 控制面 API 密钥，请运行 `openssl rand -hex 32` 生成。
OPEN_SANDBOX_API_KEY=replace-with-random-hex

# 生产模式。在线模型由每个账户在前端设置，不读取 OPENAI_*。
APP_ENV=production
MODEL_PROVIDER_HOST_ALLOWLIST=
MODEL_PROVIDER_TIMEOUT_SECONDS=120
MODEL_PROVIDER_TEST_TIMEOUT_SECONDS=20
MODEL_PROVIDER_STREAMING=false
MODEL_PROVIDER_CACHE_SIZE=128
MODEL_PROVIDER_CACHE_TTL_SECONDS=900
TAVILY_API_KEY=replace-me

# Redis、MongoDB、PostgreSQL 和 OpenSandbox 均由同一 Compose 提供。
REDIS_URL=redis://redis:6379/0
REDIS_USERNAME=ddra
REDIS_PASSWORD_FILE=/run/secrets/redis_password
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_REDIS_USERNAME=ddra-celery
CELERY_BROKER_KEY_PREFIX=ddra-celery:
MONGODB_DATABASE=deep_data_research_agent
MONGODB_SKILL_COLLECTION=skill_files
MONGODB_MEMORY_COLLECTION=memories
MONGODB_MEMORY_JOB_COLLECTION=memory_update_jobs
OPEN_SANDBOX_DOMAIN=opensandbox:8080
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_USE_SERVER_PROXY=true
OPEN_SANDBOX_TIMEOUT_SECONDS=1800

# 限流哈希密钥必须至少 32 个字符，请运行 `openssl rand -hex 32` 生成。
RATE_LIMIT_KEY_SECRET=replace-with-a-random-secret-at-least-32-characters

# OSS 仍使用阿里云服务；通过 ECS RAM Role 获取凭证，不填写长期 AccessKey。
WORKSPACE_STORAGE_BACKEND=oss
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET_NAME=my-agents
OSS_PREFIX=users
OSS_ECS_RAM_ROLE=DeepAgentsECSRole

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=deep-data-research-agent-production

# 邮件功能不使用时保持关闭。
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_SENDER_NAME=深研
