# Docker Compose 镜像配置（ECS 与 ACR 同 VPC 时使用专有网络地址）
ACR_REGISTRY=crpi-p616bctlmo5gl0r0-vpc.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=deep-agents
ACR_REPOSITORY=agent-api
# 必须替换为 GitHub Actions 成功构建时对应的完整 40 位 commit SHA。
IMAGE_TAG=replace-with-full-40-character-git-sha
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
REDIS_PASSWORD_FILE_HOST=./.secrets/redis_password

# 生产模式与模型
APP_ENV=production
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_STREAMING=false
OPENAI_TIMEOUT_SECONDS=120
TAVILY_API_KEY=replace-me

# LangGraph API 基础镜像使用 DATABASE_URI；业务代码使用 POSTGRES_URI。
# 两者可以指向同一个 PostgreSQL 实例，但账号必须分别具备所需权限。
DATABASE_URI=postgresql://langgraph_runtime:replace-me@postgres.internal:5432/langgraph
POSTGRES_URI=postgresql://deep_data_research_agent_app:replace-me@postgres.internal:5432/deep_data_research_agent

# LangGraph API 基础镜像直接读取 REDIS_URI，目前不支持本项目的密码文件约定。
# URI 中的用户名、密码若含特殊字符，需要先进行 URL 编码。
REDIS_URI=redis://langgraph-runtime:replace-me@redis.internal:6379/2

# 业务 API 和 Celery 只在运行时读取 /run/secrets/redis_password，不在这里写密码。
REDIS_URL=redis://redis.internal:6379/0
REDIS_USERNAME=ddra
REDIS_PASSWORD_FILE=/run/secrets/redis_password
CELERY_BROKER_URL=redis://redis.internal:6379/1
CELERY_REDIS_USERNAME=ddra-celery
CELERY_BROKER_KEY_PREFIX=ddra-celery:

# 限流哈希密钥必须至少 32 个字符，并使用随机值。
RATE_LIMIT_KEY_SECRET=replace-with-a-random-secret-at-least-32-characters

# MongoDB 与 OpenSandbox 使用 ECS 可访问的内网地址。
MONGODB_URI=mongodb://mongo.internal:27017
MONGODB_DATABASE=deep_data_research_agent
MONGODB_SKILL_COLLECTION=skill_files
MONGODB_MEMORY_COLLECTION=memories
MONGODB_MEMORY_JOB_COLLECTION=memory_update_jobs
OPEN_SANDBOX_DOMAIN=opensandbox.internal:8080
OPEN_SANDBOX_API_KEY=replace-me
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_USE_SERVER_PROXY=true
OPEN_SANDBOX_IMAGE=deep-data-sandbox:py313-v4
OPEN_SANDBOX_TIMEOUT_SECONDS=1800

# OSS 通过 ECS RAM Role 获取临时凭证，不要填写长期 AccessKey。
WORKSPACE_STORAGE_BACKEND=oss
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET_NAME=my-agents
OSS_PREFIX=users
OSS_ECS_RAM_ROLE=DeepAgentsECSRole

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=deep-data-research-agent-production

# 邮件功能不使用时保持关闭。
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_SENDER_NAME=深研
