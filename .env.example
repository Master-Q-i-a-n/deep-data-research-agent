# OpenAI-compatible model. The MVP assumes a non-reasoning model with stable tool calling.
OPENAI_API_KEY=your-model-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_STREAMING=false
OPENAI_TIMEOUT_SECONDS=120

# Tavily web search/crawl/extract.
TAVILY_API_KEY=tvly-your-api-key
# TAVILY_PROJECT=your-tavily-project-id

# Standalone read-only PostgreSQL MCP service. Database credentials stay in
# the ignored .env.postgres-mcp file used by its Docker container.
POSTGRES_MCP_ENABLED=false
POSTGRES_MCP_URL=http://127.0.0.1:8000/sse
POSTGRES_MCP_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_MCP_TOOL_TIMEOUT_SECONDS=30
POSTGRES_MCP_PREVIEW_ROWS=200
POSTGRES_MCP_EXPORT_ROWS=50000
POSTGRES_MCP_EXPORT_BYTES=20971520

# OpenSandbox server. The worker fails explicitly when required values are missing.
OPEN_SANDBOX_DOMAIN=127.0.0.1:8080
OPEN_SANDBOX_API_KEY=your-opensandbox-api-key
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_USE_SERVER_PROXY=true
OPEN_SANDBOX_IMAGE=deep-data-sandbox:py313-v4
OPEN_SANDBOX_TIMEOUT_SECONDS=1800
SKILL_PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 用户级动态 Skill 使用 MongoDB StoreBackend 持久化。
APP_ENV=development
LOCAL_DEV_USER_ID=local-user
MYSQL_URI=mysql+asyncmy://root:your-password@127.0.0.1:3306/deep_data_research_agent?charset=utf8mb4
AUTH_SESSION_DAYS=7
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=deep_data_research_agent
MONGODB_SKILL_COLLECTION=skill_files
MONGODB_USER_PREFERENCES_COLLECTION=user_preferences
MONGODB_MEMORY_JOB_COLLECTION=memory_update_jobs

# Long-term memory. Empty MEMORY_MODEL reuses OPENAI_MODEL.
MEMORY_MODEL=
MEMORY_UPDATE_TIMEOUT_SECONDS=10
MEMORY_EXPERIENCE_TIMEOUT_SECONDS=30

# LangSmith tracing. Never put real keys in committed files.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=deep-data-research-agent-mvp

# Successful sandbox snapshots and Supervisor artifacts.
ARTIFACT_ROOT=data/users
