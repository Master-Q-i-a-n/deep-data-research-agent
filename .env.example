# CLI/evaluation-only model. Online runs always use the signed-in user's Provider.
OPENAI_API_KEY=your-model-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_STREAMING=false
OPENAI_TIMEOUT_SECONDS=120
# Online Provider credentials are encrypted with this deployment-owned Fernet key.
# Generate it once before saving the first Provider; never commit the file.
MODEL_PROVIDER_ENCRYPTION_KEY_FILE=.secrets/model_provider_key
# Add only trusted hosts or CIDRs that are allowed to use plain HTTP.
MODEL_PROVIDER_HOST_ALLOWLIST=
MODEL_PROVIDER_TIMEOUT_SECONDS=120
MODEL_PROVIDER_TEST_TIMEOUT_SECONDS=20
# Keep enabled so tokens and Responses web-search events reach the UI in real time.
MODEL_PROVIDER_STREAMING=true
MODEL_PROVIDER_CACHE_SIZE=128
MODEL_PROVIDER_CACHE_TTL_SECONDS=900
# Tavily web search/crawl/extract.
TAVILY_API_KEY=tvly-your-api-key
# TAVILY_PROJECT=your-tavily-project-id

# Standalone read-only PostgreSQL MCP service. Database credentials stay in
# the ignored .env.postgres-mcp file used by its Docker container.
POSTGRES_MCP_ENABLED=false
POSTGRES_MCP_URL=http://127.0.0.1:8000/sse
POSTGRES_MCP_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_MCP_TOOL_TIMEOUT_SECONDS=30
POSTGRES_MCP_PREVIEW_ROWS=200
POSTGRES_MCP_EXPORT_ROWS=50000
POSTGRES_MCP_EXPORT_BYTES=20971520

# OpenSandbox server. The worker fails explicitly when required values are missing.
OPEN_SANDBOX_DOMAIN=127.0.0.1:8080
OPEN_SANDBOX_API_KEY=your-opensandbox-api-key
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_USE_SERVER_PROXY=true
OPEN_SANDBOX_IMAGE=deep-data-sandbox:py313-v4
OPEN_SANDBOX_TIMEOUT_SECONDS=1800
SANDBOX_LOCK_WAIT_SECONDS=5
SANDBOX_LOCK_LEASE_SECONDS=180
SANDBOX_LOCK_RENEW_SECONDS=30
SANDBOX_DELETE_TOMBSTONE_SECONDS=600
SKILL_PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 用户级动态 Skill 使用 MongoDB StoreBackend 持久化。
APP_ENV=development
LOCAL_DEV_USER_ID=local-user
POSTGRES_URI=postgresql://deep_data_research_agent_app:your-password@127.0.0.1:5432/deep_data_research_agent
POSTGRES_APP_POOL_SIZE=5
POSTGRES_APP_MAX_OVERFLOW=10
POSTGRES_CHECKPOINT_POOL_MIN_SIZE=1
POSTGRES_CHECKPOINT_POOL_MAX_SIZE=5
POSTGRES_POOL_TIMEOUT_SECONDS=30
LANGGRAPH_STRICT_MSGPACK=true
AUTH_SESSION_DAYS=7
# Production requires a stable secret of at least 32 characters. Development
# uses an ephemeral process-local secret when this is empty.
RATE_LIMIT_KEY_SECRET=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_USERNAME=ddra
REDIS_PASSWORD_FILE=.secrets/redis_password
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
HEALTH_CHECK_TIMEOUT_SECONDS=2
# Celery shares the Redis container but uses DB 1 and a separate ACL identity.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_REDIS_USERNAME=ddra-celery
CELERY_BROKER_KEY_PREFIX=ddra-celery:
CELERY_VISIBILITY_TIMEOUT_SECONDS=300
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REGISTER_LIMIT=3
AUTH_REGISTER_WINDOW_SECONDS=3600
QUESTION_LIMIT=20
QUESTION_WINDOW_SECONDS=60
THREAD_CONCURRENCY_LIMIT=3
TOKEN_BUCKET_CAPACITY=100000000
TOKEN_BUCKET_REFILL_PER_HOUR=10000000
TOKEN_RESERVATION_OUTPUT_TOKENS=8192
RUN_PERMIT_TTL_SECONDS=30
RUN_RESERVATION_TTL_SECONDS=15
RUN_ADMISSION_LOCK_SECONDS=5
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=deep_data_research_agent
MONGODB_SKILL_COLLECTION=skill_files
MONGODB_MEMORY_COLLECTION=memories
MONGODB_MEMORY_JOB_COLLECTION=memory_update_jobs

# Fixed QQ SMTP sender. Put real credentials only in the ignored local .env.
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-account@qq.com
SMTP_PASSWORD=your-qq-mail-authorization-code
SMTP_USE_SSL=true
SMTP_SENDER_NAME=深研
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_ATTACHMENT_BYTES=20971520

# Long-term memory. Empty MEMORY_MODEL reuses OPENAI_MODEL.
MEMORY_MODEL=
MEMORY_MODEL_TIMEOUT_SECONDS=60
MEMORY_JOB_TIMEOUT_SECONDS=75
FAILURE_REVIEW_MAX_OUTPUT_TOKENS=4096
FAILURE_REVIEW_BUNDLE_MAX_BYTES=262144
FAILURE_REVIEW_PAYLOAD_TTL_HOURS=24

# LangSmith tracing. Never put real keys in committed files.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=deep-data-research-agent-mvp

# Successful sandbox snapshots and Supervisor artifacts. Development uses local
# files; production must use OSS with an ECS RAM Role rather than a static AK.
WORKSPACE_STORAGE_BACKEND=local
ARTIFACT_ROOT=data/users
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_BUCKET_NAME=
OSS_PREFIX=users
OSS_ECS_RAM_ROLE=DeepAgentsECSRole
